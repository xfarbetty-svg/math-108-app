      "explanation": {
        "concept": "起點與長度的加法關係",
        "steps": [
          "已知起點是刻度 2。",
          "需要畫出的長度是 5 公分。",
          "計算終點：2 + 5 = 7，所以要畫到刻度 7。"
        ],
        "trap": "看到 5 公分就直接畫到刻度 5。"
      }
